# Back-end root URL, without /graphql (e.g. https://api.example.com).
# Leave empty to call the same origin: the Vite proxy in dev, the reverse proxy in production.
VITE_BACKEND_URL=

# Dev only: back-end root, without /graphql, where the Vite proxy sends /graphql and /auth/google
# (default http://localhost:3000)
API_PROXY_TARGET=
